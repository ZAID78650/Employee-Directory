      "title": "Employee Directory - Service Uptime / Target UP",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"employee-directory-service\"}",
          "legendFormat": "App Up (1=UP, 0=DOWN)",
          "refId": "B"
