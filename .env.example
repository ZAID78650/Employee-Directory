# ==============================================================================
# EMPLOYEE DIRECTORY — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Application Port (Default: 5001)
PORT=5001

# Flask Secret Key for Encrypted Session State (Generate a 32+ byte random string)
SECRET_KEY=devops-employee-directory-super-secret-key-2026

# Base URLs
FRONTEND_URL=http://localhost:5001
BACKEND_URL=http://localhost:5001
# For Vercel Production:
# FRONTEND_URL=https://employee-directory-seven-gules.vercel.app
# BACKEND_URL=https://employee-directory-seven-gules.vercel.app

# ------------------------------------------------------------------------------
# 1. Google Cloud OAuth 2.0 Web Client Credentials
# ------------------------------------------------------------------------------
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins:
#   - http://localhost:5001
#   - https://employee-directory-seven-gules.vercel.app
# Authorized Redirect URIs:
#   - http://localhost:5001/auth/google/callback
#   - https://employee-directory-seven-gules.vercel.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/google/callback
GOOGLE_SCOPES=openid profile email

# ------------------------------------------------------------------------------
# 2. GitHub OAuth App Credentials
# ------------------------------------------------------------------------------
# Obtain from: https://github.com/settings/developers
# Homepage URL: https://employee-directory-seven-gules.vercel.app
# Authorization Callback URL:
#   - http://localhost:5001/auth/github/callback (local)
#   - https://employee-directory-seven-gules.vercel.app/auth/github/callback (prod)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5001/auth/github/callback
GITHUB_SCOPES=read:user user:email

# ------------------------------------------------------------------------------
# 3. GitLab OAuth Application Credentials
# ------------------------------------------------------------------------------
# Obtain from: https://gitlab.com/-/profile/applications
# Redirect URI:
#   - http://localhost:5001/auth/gitlab/callback (local)
#   - https://employee-directory-seven-gules.vercel.app/auth/gitlab/callback (prod)
# Scopes: read_user, openid, profile, email
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:5001/auth/gitlab/callback
GITLAB_SCOPES=read_user openid profile email
