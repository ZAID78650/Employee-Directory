# ==============================================================================
# EMPLOYEE DIRECTORY — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application Port
PORT=5001

# Flask Secret Key for Encrypted Session State
SECRET_KEY=devops-employee-directory-super-secret-key-2026

# Google Cloud OAuth 2.0 Web Application Credentials
# Obtain these from: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5001
# Authorized Redirect URI: http://localhost:5001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/google/callback
GOOGLE_SCOPES=openid profile email

# GitHub OAuth App Credentials
# Obtain from: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5001/auth/github/callback
GITHUB_SCOPES=read:user user:email

# GitLab OAuth Application Credentials
# Obtain from: https://gitlab.com/-/profile/applications
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:5001/auth/gitlab/callback
GITLAB_SCOPES=read_user openid profile email
